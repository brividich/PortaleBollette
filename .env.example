# --- Bridge Home Assistant (ADR-002) ---
# Copia in .env e NON committare i valori reali.

# URL base di Home Assistant (incluso schema e porta). Niente slash finale.
HA_BASE_URL=https://homeassistant.local:8123

# Long-Lived Access Token di Home Assistant. Segreto: mai nel repo, mai nei log.
HA_TOKEN=

# Verifica TLS del certificato HA.
#   True  -> verifica (consigliato; per self-signed usa HA_CA_BUNDLE)
#   False -> disabilita la verifica (sconsigliato, logga un warning)
HA_TLS_VERIFY=True

# Path a un CA bundle / certificato custom per validare un HA self-signed.
# Lasciare vuoto se HA_TLS_VERIFY=True con CA pubblica, o se HA_TLS_VERIFY=False.
HA_CA_BUNDLE=

# Modalita di calcolo del prezzo pubblicato in HA (ADR-002 punto c).
#   ultima_bolletta | media_mobile_12m
PREZZO_HA_MODE=media_mobile_12m

# Entity dei consumi da leggere per la validazione (ADR-002 punto d).
# Puoi scoprirle cliccando sul pulsante "🔍 Scopri Sensori HA" nella dashboard.
HA_ENTITY_KWH_CONSUMO=
HA_ENTITY_SMC_CONSUMO=

# Entity helpers per pubblicazione prezzo (default standard).
HA_ENTITY_PREZZO_SINGOLO=input_number.prezzo_energia_kwh
HA_ENTITY_PREZZO_GAS=input_number.prezzo_gas_smc

# Sensore PUN in HA (opzionale, es. pun_sensor di virtualdj).
HA_ENTITY_PUN=sensor.pun_mono

# Sync automatica del prezzo in HA a fine ingest bolletta (True/False).
HA_SYNC_AUTO=False

# --- Open-Meteo API (Gradi Giorno / Normalizzazione Climatica) ---
# Coordinate geografiche della tua abitazione (default: Roma).
METEO_LATITUDE=41.9028
METEO_LONGITUDE=12.4964

# --- Pipeline Ingest PDF & Ollama LLM (ADR-001) ---
# Indirizzo del server Ollama sul PC desktop con RTX 5070 Ti (se acceso).
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:latest

# --- Django ---
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_DEBUG=True

# --- Superuser admin creato al primo avvio da avvia.bat ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=bovaluca95@gmail.com
DJANGO_SUPERUSER_PASSWORD=

# --- Sicurezza & Controllo Accessi ---
# Se True, richiede il login per tutte le pagine del portale e protegge le API/viste smart plug (default: False).
PORTALE_REQUIRE_LOGIN=False

# --- Parametri Fiscali Elettrici (default Acea / ARERA) ---
FRANCHIGIA_ACCISA_KWH=150
SOGLIA_RECUPERO_ACCISA_KWH=220
ALIQUOTA_ACCISA_ORDINARIA=0.0227
ALIQUOTA_IVA_LUCE=0.10
